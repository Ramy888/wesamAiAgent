{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "test": "deno test --allow-read=reference",
    "serve": "deno run --env-file=.env --allow-net=0.0.0.0 --allow-env=HESBA_TOKENS,PORT,HESBA_CHART_SECRET,PUBLIC_BASE_URL server/main.ts",
    "check": "deno check server/main.ts && deno lint && deno fmt --check",
    "deploy": "bash scripts/deploy.sh",
    "deploy:cf": "deno task test && npx wrangler deploy"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "reference/",
      "landing/",
      "specs/",
      "wesam/",
      "CLAUDE.md",
      "README.md",
      "tests/oracle/",
      "docs/deck"
    ]
  },
  "lint": {
    "exclude": [
      "reference/",
      "landing/",
      "tests/oracle/"
    ]
  },
  "test": {
    "include": [
      "tests/"
    ]
  },
  "deploy": {
    "org": "hesba",
    "app": "hesba-calculator"
  }
}
