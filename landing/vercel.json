{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp/:path*",
      "destination": "https://hesba-calculator.ramy-comm.workers.dev/mcp/:path*"
    },
    {
      "source": "/chart/:path*",
      "destination": "https://hesba-calculator.ramy-comm.workers.dev/chart/:path*"
    },
    {
      "source": "/health",
      "destination": "https://hesba-calculator.ramy-comm.workers.dev/health"
    }
  ]
}
